{
  "name": "chikochan",
  "version": "2.0.0",
  "description": "A lightweight Node.js imageboard inspired by Vichan.",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/start.js",
    "start:local": "node scripts/start-local.js",
    "dev": "node --watch server.js",
    "migrate:mongo": "node scripts/migrate-to-mongo.js",
    "verify:upgrade": "node scripts/verify-upgrade.js",
    "backup:local": "node scripts/backup-local.js",
    "restore:local": "node scripts/restore-local.js",
    "seed:load": "node scripts/seed-load-fixture.js",
    "load:test": "node scripts/load-benchmark.js",
    "diagnose": "node scripts/diagnose.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "setup": "node scripts/settings.js setup",
    "settings": "node scripts/settings.js",
    "migrate:settings": "node scripts/settings.js migrate"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "imageboard",
    "vichan",
    "4chan-api",
    "mongodb"
  ],
  "author": "ChikoChan contributors",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "mongodb": "^6.21.0",
    "multer": "^2.2.0"
  }
}
